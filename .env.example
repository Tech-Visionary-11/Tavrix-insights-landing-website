# Copy to .env.local for local development. NEXT_PUBLIC_* values are inlined at build time,
# so redeploy after changing them in your hosting provider.

# Public URL of the Tavrix Insights web app / dashboard (agent-watch-fe), no trailing slash.
# Used by the "Start Monitoring My Agents" button (/dashboard) and the "Add New Agent" link (/agents/add).
# If unset, both links fall back to /help-docs.
NEXT_PUBLIC_WEBAPP_FE_URL=https://your-dashboard.example.com

# Public URL of the backend API (agent-watch-be, FastAPI). Used only in the API curl examples in Help Docs.
NEXT_PUBLIC_WEBAPP_BE_URL=https://your-api.example.com

# Public URL of this landing site. Used for Open Graph / canonical URLs.
NEXT_PUBLIC_AGENT_WATCH_SITE_URL=https://your-landing-site.example.com

# Strapi CMS base URL used by the /blogs pages.
NEXT_PUBLIC_STRAPI_API_URL=https://your-strapi.example.com

# Site URL for next-sitemap (only used if next-sitemap is run).
NEXT_PUBLIC_SITE_URL=https://your-landing-site.example.com
